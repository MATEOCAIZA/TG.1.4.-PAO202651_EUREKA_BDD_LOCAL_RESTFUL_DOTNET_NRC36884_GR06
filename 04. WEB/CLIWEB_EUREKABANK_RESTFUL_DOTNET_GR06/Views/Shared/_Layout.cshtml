<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewBag.Title &mdash; Eureka Bank</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
<nav class="navbar navbar-expand-sm navbar-dark" style="background:#1a3e6b">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold" href="@Url.Action("Index","Cuentas")">&#127981; Eureka Bank</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse">
            <ul class="navbar-nav me-auto">
                <li>@Html.ActionLink("Cuentas", "Index", "Cuentas", null, new { @class = "nav-link text-white" })</li>
                <li>@Html.ActionLink("MashUp", "Index", "MashUp", null, new { @class = "nav-link text-white" })</li>
            </ul>
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link text-white" href="@Url.Action("Logout","Auth")">&#128274; Cerrar sesi&oacute;n</a>
                </li>
            </ul>
        </div>
    </div>
</nav>
<div class="container-fluid py-4">
    @RenderBody()
</div>
@Scripts.Render("~/bundles/jquery")
@Scripts.Render("~/bundles/bootstrap")
@RenderSection("scripts", required: false)
</body>
</html>
